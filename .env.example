PORT=3000
CAFE24_MALL_ID=
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
CAFE24_REDIRECT_URI=http://localhost:3000/oauth/cafe24/callback
CAFE24_SCOPES=mall.read_product,mall.read_order,mall.read_analytics
CAFE24_SHOP_NO=1
CAFE24_API_VERSION=2026-03-01
CAFE24_SYNC_DAYS=7
CAFE24_TOKEN_STORE=supabase

# Server only. Never prefix either variable with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Coupang WING Open API (server only; never prefix with NEXT_PUBLIC_)
COUPANG_VENDOR_ID=
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_SYNC_DAYS=7
COUPANG_ALLOWED_SOURCE_IP=

# Override only if the current Analytics API uses different paths.
CAFE24_ANALYTICS_VISITORS_PATH=/visitors/view
CAFE24_ANALYTICS_PAGEVIEWS_PATH=/visitors/pageview
CAFE24_ANALYTICS_REFERRERS_PATH=/visitpaths/domains
DASHBOARD_PASSWORD=change-me

# Vercel Cron 전용 인증키. 길고 무작위인 값으로 설정하고 브라우저에 노출하지 않습니다.
CRON_SECRET=
