PORT=3000
CAFE24_MALL_ID=
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
CAFE24_REDIRECT_URI=http://localhost:3000/oauth/cafe24/callback
CAFE24_SCOPES=mall.read_product,mall.write_product,mall.read_order,mall.write_order,mall.read_community,mall.write_community,mall.read_analytics
CAFE24_SHOP_NO=1
CAFE24_API_VERSION=2026-03-01
CAFE24_SYNC_DAYS=7
CAFE24_TOKEN_STORE=supabase

# Server only. Never prefix either variable with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Harin AI explanations (server only; never prefix with NEXT_PUBLIC_)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Optional: connect an approved planning-document vector store for File Search.
OPENAI_VECTOR_STORE_ID=

# Coupang WING Open API (server only; never prefix with NEXT_PUBLIC_)
COUPANG_VENDOR_ID=
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_SYNC_DAYS=7
COUPANG_ALLOWED_SOURCE_IP=13.124.12.17
COUPANG_COLLECTOR_ID=harin-coupang-worker
COUPANG_PRODUCT_WRITE_ENABLED=false

# Naver SmartStore Commerce API. Register Seoul fixed IP 13.124.12.17.
# Keep these values on the fixed-IP worker; never use NEXT_PUBLIC_.
NAVER_COMMERCE_CLIENT_ID=
NAVER_COMMERCE_CLIENT_SECRET=
NAVER_COMMERCE_TOKEN_TYPE=SELF
NAVER_COMMERCE_ACCOUNT_ID=
NAVER_COMMERCE_WRITE_ENABLED=false

# Naver Search Ads API (server only). Keep credentials separate from Commerce API.
NAVER_CUSTOMER_ID=
NAVER_API_KEY=
NAVER_SECRET_KEY=
NAVER_SEARCH_AD_WRITE_ENABLED=false

# NAVER API HUB (Search Trend, Shopping Insight and Search API; server only).
# These are API HUB credentials, not Commerce or Search Ads credentials.
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=

# Phase 19-1 owned-site diagnostics (server-only, read-only).
# Grant the service-account email Viewer access in Search Console and GA4.
HUB_OWNED_SITE_URL=https://your-store.example.com
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://your-store.example.com/
GOOGLE_GA4_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Preserve newlines as \\n when saving the JSON private key in an environment variable.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# 선택 사항: PageSpeed는 키 없이도 수동 확인할 수 있으며, 잦은 자동 수집에는 키 사용을 권장합니다.
GOOGLE_PAGESPEED_API_KEY=
GOOGLE_CRUX_API_KEY=
GOOGLE_SEARCH_CONSOLE_ENABLED=true
GOOGLE_GA4_ENABLED=true
GOOGLE_PAGESPEED_ENABLED=true
GOOGLE_CRUX_ENABLED=true

# Phase 19-2 official food safety, recall and law Evidence (server-only, read-only).
# These values may be added together during the final Phase 18-21 credential pass.
FOOD_SAFETY_KOREA_API_KEY=
KOREAN_LAW_API_OC=
FOOD_SAFETY_PRODUCT_ENABLED=true
FOOD_SAFETY_RECALL_ENABLED=true
KOREAN_LAW_ENABLED=true
# Optional. Falls back to an existing server-only secret when omitted.
OFFICIAL_EVIDENCE_SIGNING_SECRET=

# Korea Post contract parcel OpenAPI. Keep every value on the fixed-IP worker.
# Never copy authentication or SEED keys into NEXT_PUBLIC_ variables or Git.
EPOST_API_KEY=
EPOST_TRACKING_API_KEY=
EPOST_SECURITY_KEY=
EPOST_CUSTOMER_NO=
EPOST_CONTRACT_APPROVAL_NO=
EPOST_OFFICE_SERIAL=
EPOST_ALLOWED_SOURCE_IP=13.124.12.17
# Allows only testYn=Y requests, which return TESTREGINOAPI and are not sent to the pickup post office.
EPOST_TEST_WRITES_ENABLED=false
# Keep locked until phase 11-3C test parcel issuance is explicitly approved.
EPOST_LIVE_WRITES_ENABLED=false

# Override only if the current Analytics API uses different paths.
CAFE24_ANALYTICS_VISITORS_PATH=/visitors/view
CAFE24_ANALYTICS_PAGEVIEWS_PATH=/visitors/pageview
CAFE24_ANALYTICS_REFERRERS_PATH=/visitpaths/domains
DASHBOARD_SESSION_SECRET=replace-with-a-random-server-only-secret

# Vercel Cron 전용 인증키. 길고 무작위인 값으로 설정하고 브라우저에 노출하지 않습니다.
CRON_SECRET=

# Optional server-only email delivery. Never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
REPORT_FROM_EMAIL=Harin Food Hub <reports@your-verified-domain.com>
PUBLIC_APP_URL=https://harin-cafe24-sync.vercel.app

# Phase 19-3. Keep both server-only. The owner will enter all deferred keys
# together after Phase 18-21 is complete.
HOLIDAY_CALENDAR_ENABLED=true
KASI_HOLIDAY_API_KEY=
ROAD_ADDRESS_LOOKUP_ENABLED=true
JUSO_ROAD_ADDRESS_API_KEY=

# Phase 19-4 server/deployment health (server-only, read-only).
# Enter these together with the other deferred keys after Phase 18-21 is complete.
AWS_CLOUDWATCH_ENABLED=true
AWS_CLOUDWATCH_REGION=ap-northeast-2
AWS_CLOUDWATCH_ACCESS_KEY_ID=
AWS_CLOUDWATCH_SECRET_ACCESS_KEY=
AWS_CLOUDWATCH_SESSION_TOKEN=
AWS_CLOUDWATCH_INSTANCE_ID=
VERCEL_HEALTH_ENABLED=true
VERCEL_HEALTH_TOKEN=
VERCEL_HEALTH_PROJECT_ID=
VERCEL_HEALTH_TEAM_ID=

# Phase 19-5 product-isolated market context (server-only, read-only).
# These keys stay deferred until the final Phase 18-21 credential pass.
KAMIS_PRICE_ENABLED=true
KAMIS_API_KEY=
KAMIS_API_ID=
KMA_WEATHER_ENABLED=true
KMA_API_HUB_KEY=
KMA_FORECAST_REGION_CODE=11F20000
KMA_FORECAST_REGION_LABEL=광주·전남
YOUTUBE_EVIDENCE_ENABLED=true
YOUTUBE_DATA_API_KEY=

# Phase 19-6 owner-approved repurchase messages (server-only).
# Keep keys deferred until the final Phase 18-21 credential pass.
SOLAPI_REPURCHASE_ENABLED=true
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_NUMBER=
SOLAPI_OPTOUT_NUMBER=
# Actual sends remain locked until the owner finishes a live-readiness review.
SOLAPI_REPURCHASE_WRITES_ENABLED=false

# Phase 20-1 research Evidence (server-only, read-only).
# PubMed, ClinicalTrials.gov and Crossref all work without a required API key.
# The NCBI key only raises the PubMed request limit and stays deferred until the
# final Phase 18-21 credential pass. This is a developer contact, never customer PII.
NCBI_EUTILS_ENABLED=true
NCBI_EUTILS_API_KEY=
NCBI_EUTILS_TOOL=harin_food_hub
NCBI_EUTILS_EMAIL=
CLINICAL_TRIALS_ENABLED=true
CROSSREF_ENABLED=true
CROSSREF_MAILTO=

# Phase 20-2 product-isolated label cross-check (server-only, read-only).
# These keys remain deferred until the final Phase 18-21 credential pass.
MFDS_NUTRITION_ENABLED=true
DATA_GO_KR_SERVICE_KEY=
FOOD_SAFETY_HACCP_ENABLED=true
FOOD_SAFETY_INGREDIENT_ENABLED=true
USDA_FDC_ENABLED=true
USDA_FDC_API_KEY=

# Phase 20-3 product-isolated raw-material and market context (server-only, read-only).
# Reuse DATA_GO_KR_SERVICE_KEY above for the approved Customs Service API.
# These keys remain deferred until the final Phase 18-21 credential pass.
KCS_TRADE_ENABLED=true
KOREA_EXIM_FX_ENABLED=true
KOREA_EXIM_API_KEY=
KOSIS_MARKET_ENABLED=true
KOSIS_API_KEY=
