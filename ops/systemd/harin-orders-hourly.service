[Unit]
Description=Harin hourly all-platform order collection
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/harin-food-hub/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/harin-coupang-worker.env
ExecStart=/usr/bin/node scripts/hourly-order-trigger.js
NoNewPrivileges=true
PrivateTmp=true
