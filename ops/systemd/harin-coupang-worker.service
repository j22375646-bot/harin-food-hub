[Unit]
Description=Harin Food channel fixed-IP worker (Coupang, Naver, ePost)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/harin-food-hub/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/harin-coupang-worker.env
ExecStart=/usr/bin/node scripts/coupang-local-worker.js --watch --quiet
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
