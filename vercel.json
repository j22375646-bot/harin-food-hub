{
  "buildCommand": "pnpm build && node scripts/verify-managed-web.js",
  "functions": {
    "app/api/moaon/businesses/*/assistant/route.js": {
      "regions": [
        "sin1"
      ]
    },
    "app/api/moaon/businesses/*/orders/route.js": {
      "regions": [
        "sin1"
      ]
    },
    "app/api/moaon/businesses/route.js": {
      "regions": [
        "sin1"
      ]
    },
    "app/api/moaon/connections/route.js": {
      "regions": [
        "sin1"
      ]
    },
    "app/api/moaon/businesses/*/insights/ai/route.js": {
      "regions": [
        "sin1"
      ]
    },
    "app/api/moaon/businesses/*/market-ai/route.js": {
      "regions": [
        "sin1"
      ]
    },
    "app/api/moaon/businesses/*/general-chat/route.js": {
      "regions": [
        "sin1"
      ]
    },
    "app/api/moaon/assistant/*/route.js": {
      "regions": [
        "sin1"
      ]
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-sync",
      "schedule": "30 20 * * *"
    },
    {
      "path": "/api/cron/platform-reports",
      "schedule": "10 22 * * *"
    },
    {
      "path": "/api/cron/weekly-report",
      "schedule": "30 22 * * 0"
    },
    {
      "path": "/api/cron/monthly-reports",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/naver-marketing",
      "schedule": "0 22 * * *"
    }
  ]
}
